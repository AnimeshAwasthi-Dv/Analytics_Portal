# Local development (set DATABASE_URL to your PostgreSQL instance when ready)
DATABASE_URL=sqlite:///./central_sync.db

APP_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION=60
COOKIE_SECURE=false
XRAY_TEST_TYPE_ID=1
CT_TEST_TYPE_ID=2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:4173

INITIAL_ADMIN_EMAIL=admin@local.com
INITIAL_ADMIN_PASSWORD=replace-before-use
MARENGO_API_KEY=replace-before-use
PACS_API_KEY=replace-before-use

# Source database URLs. Paste the connection URL for any source you want to sync.
# The source database user should have read-only access. Leave unused URLs blank.
MARENGO_DATABASE_URL=postgresql+psycopg://readonly:URL_ENCODED_PASSWORD@MARENGO_DB_HOST:5432/SOURCE_DB?sslmode=require
PACS_DATABASE_URL=
API_CONTROL_DATABASE_URL=
SOURCE_LICENSE_DATABASE_URL=
SOURCE_SYNC_BATCH_SIZE=500
