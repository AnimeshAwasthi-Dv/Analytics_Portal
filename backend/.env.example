# Local development (set DATABASE_URL to your PostgreSQL instance when ready)
DATABASE_URL=sqlite:///./central_sync.db

APP_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION=60
COOKIE_SECURE=false
XRAY_TEST_TYPE_ID=1
CT_TEST_TYPE_ID=2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:4173

INITIAL_ADMIN_EMAIL=admin@local.com
INITIAL_ADMIN_PASSWORD=replace-before-use
MARENGO_API_KEY=replace-before-use
PACS_API_KEY=replace-before-use

# Source database URLs. Paste the connection URL for any source you want to sync.
# The source database user should have read-only access. Leave unused URLs blank.
MARENGO_DATABASE_URL=postgresql+psycopg://readonly:URL_ENCODED_PASSWORD@MARENGO_DB_HOST:5432/SOURCE_DB?sslmode=require
PACS_DATABASE_URL=
API_CONTROL_DATABASE_URL=
SOURCE_LICENSE_DATABASE_URL=
SOURCE_SYNC_BATCH_SIZE=500

# Central command: independent source credentials; sync uses read-only transactions.
GOYAL_DATABASE_URL=
# Optional override; defaults to SOURCE_LICENSE_DATABASE_URL (sx_portal schema).
ONPREM_DATABASE_URL=
# Map exact shared-PACS center IDs to their canonical client. Never match by name.
# Example: {"pacs:SOURCE_GOYAL_CENTER_ID":"goyal"}
COMMAND_CENTER_CLIENT_MAP={}

# Single Sign-On (SSO) configuration to Task Manager
SSO_ISSUER=pacs-analytics-portal
SSO_AUDIENCE=task-manager-portal
SSO_SHARED_SECRET=replace-with-a-random-shared-secret-at-least-32-chars
TASK_MANAGER_SSO_URL=https://task.admindectrocel.online

# Separate write credentials for the audited control worker. Leave blank to disable controls.
# Host, port and database must match the corresponding analytics source.
MARENGO_CONTROL_DATABASE_URL=
GOYAL_CONTROL_DATABASE_URL=
PACS_CONTROL_DATABASE_URL=
ONPREM_CONTROL_DATABASE_URL=

# DICOM viewer: repeat this block with MARENGO_VIEWER_ and GOYAL_VIEWER_
# for independent source storage/service credentials. Never use VITE_ for secrets.
PACS_VIEWER_UPLOAD_ROOTS=
PACS_VIEWER_S3_ACCESS_KEY_ID=
PACS_VIEWER_S3_SECRET_ACCESS_KEY=
PACS_VIEWER_S3_REGION=ap-south-1
PACS_VIEWER_S3_ENDPOINT=
PACS_VIEWER_S3_FORCE_PATH_STYLE=false
PACS_VIEWER_S3_CT_STUDIES_BUCKET=
PACS_VIEWER_S3_CT_STUDIES_PREFIX=
PACS_VIEWER_S3_MRI_STUDIES_BUCKET=
PACS_VIEWER_S3_MRI_STUDIES_PREFIX=
PACS_VIEWER_S3_XRAY_STUDIES_BUCKET=
PACS_VIEWER_S3_XRAY_STUDIES_PREFIX=
PACS_VIEWER_S3_MAMMOGRAPHY_STUDIES_BUCKET=
PACS_VIEWER_S3_MAMMOGRAPHY_STUDIES_PREFIX=
PACS_VIEWER_DICOM_VIEWER_API_URL=
PACS_VIEWER_DICOM_VIEWER_PUBLIC_URL=
PACS_VIEWER_DICOM_VIEWER_SERVICE_API_KEY=

# Conversational AI assistant. Server only; never expose a key through VITE_.
OPENAI_API_KEY=
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=gpt-5.4
ASSISTANT_REASONING=low
